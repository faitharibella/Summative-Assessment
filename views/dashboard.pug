doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Inventory Dashboard
  link(rel='stylesheet' href='/css/style.css')
  link(href='https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap' rel='stylesheet')
.dashboard-container
  .top-section
    .stats-grid
      .card.dual-card
        .stat-box
          h2 UGX 50,000,000
          p Sales
        .divider
        .stat-box
          h2 UGX 15,000,000
          p Orders
      .card.green-card
        h2.text-green UGX #{totalStockValue.toLocaleString()}
        p In stock
      .card.red-card
        h2.text-red 5
        p Out of stock
    .form-card
      h3 Add Product
      
      //- SUCCESS FLASH ALERT: Added here, perfectly indented!
      if alertSuccess
        .alert-banner-green
          span Product has been added successfully!
          button.alert-close-btn(type='button' onclick='this.parentElement.remove()') x

      form(action='/dashboard' method='POST' enctype='multipart/form-data' id='productForm' novalidate)
        
        .input-group
          input(type='text' name='name' placeholder='Product Name' required)
          span.error-msg
          
        .input-group
          input(type='text' name='category' placeholder='Category' required)
          span.error-msg
          
        .input-group
          input(type='number' name='price' placeholder='Price' required)
          span.error-msg
          
        .input-group
          input(type='number' name='quantity' placeholder='Quantity' required)
          span.error-msg
          
        .form-row-split
          .input-group
            input(type='text' name='color' placeholder='Color' required)
            span.error-msg
          .input-group
            input(type='file' name='productImage' accept='image/*' required)
            span.error-msg
            
        .form-row-split
          button.btn-save(type='submit') SAVE
          button.btn-clear(type='reset') CLEAR
  .table-section
    table
      thead
        tr
          th ID
          th NAME
          th CATEGORY
          th PRICE (UGX)
          th QUANTITY
      tbody
        if products && products.length > 0
          each product in products
            tr
              td ##{product._id.toString().substring(18).toUpperCase()}
              td #{product.name}
              td #{product.category}
              td #{product.price.toLocaleString()}
              td #{product.quantity}
        else
          tr
            td(colspan="5" style="text-align: center; color: #888;") No products in stock. Add some above!

script(src='/js/validation.js')