doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Sign Up
  link(rel='stylesheet' href='/css/signup.css')
.container
  h1 Sign Up
  
  if signupSuccess
    .alert-banner-green
      span Account created successfully! — 
        a.alert-link(href='/login') Login
      button.alert-close-btn(type='button' onclick='this.parentElement.remove()') X

  //- Ensure id and novalidate are right here:
  form(action='/signup' method='POST' id='signupForm' novalidate)
    input(type='text' name='fullname' placeholder='Full Name' required)
    input(type='email' name='email' placeholder='Email' required)
    input(type='text' name='phone' placeholder='Phone Number' required)
    input(type='password' name='password' placeholder='Password' required)
    input(type='password' name='confirmPassword' placeholder='Confirm Password' required)
    button(type='submit') SIGN UP
    
  p
    | Already have an account? 
    a(href='/login') Login

//- Load the validation logic at the very end of the page
script.
  document.getElementById('signupForm').addEventListener('submit', function(event) {
      let formIsValid = true;
      const inputs = this.querySelectorAll('input[required]');
      
      // Reset any previous red borders
      inputs.forEach(input => {
          input.classList.remove('invalid-input');
      });

      // Loop through and find empty spaces
      inputs.forEach(input => {
          if (input.value.trim() === '') {
              formIsValid = false;
              input.classList.add('invalid-input'); // This triggers the red line!
          }
      });

      // Stop the form submission if any inputs are empty
      if (!formIsValid) {
          event.preventDefault();
      }
  });